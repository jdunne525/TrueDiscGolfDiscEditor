# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local save material. Everything under saves/ is local except the sample save the
# real-file-shape test reads.
saves/*
!saves/sample-save.es3

# Write backups land next to the save in AppData, but keep the pattern for any copy
# that ends up in the working tree.
*.es3.bak-*

# Editors and operating systems
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.orig
*.tmp
*.log
